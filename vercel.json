{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "public/**",
      "excludeFiles": "{node_modules/**,dist/**,.git/**,.venv/**,demo/**,test-results/**,.pytest_cache/**,**/__pycache__/**,plan.md,BENCHMARK.md,PERFORMANCE.md}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
